{
  "name": "clawjs-publishing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Generic publication framework for ClawJS. Author content, schedule it, fan it out to many destinations, observe what happens.",
  "scripts": {
    "dev": "tsx watch src/bin/server.ts",
    "build": "tsup src/bin/server.ts src/bin/cli.ts --format esm --target node20 --out-dir dist --clean",
    "start": "node dist/server.js",
    "cli": "node dist/cli.js",
    "test": "vitest run --config vitest.config.ts && tsx --test tests/e2e/*.test.ts",
    "test:adapters": "tsx --test tests/e2e/adapters/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.2.1",
    "@fastify/static": "^8.1.0",
    "@fastify/websocket": "^11.2.0",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.15",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
