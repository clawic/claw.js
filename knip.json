        "vitest.config.{ts,js,mjs}",
        "playwright.config.{ts,js,mjs}"
      ],
      "project": [
        "src/**/*.{ts,tsx,js,mjs}",
        "*.{ts,js,mjs}",
        "*.config.{ts,js,mjs,cjs}"
      ]
    }
  }
}
