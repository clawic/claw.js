      "maxRank": 25
    },
    {
      "id": "portable-archive-command",
      "query": "archive command",
      "domains": [
        "surfaces"
      ],
      "expectSource": "surfaces.registry",
      "expectType": "surface",
      "expectResourceId": "claw.cli.command.archive",
