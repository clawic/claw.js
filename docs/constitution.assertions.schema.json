{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Constitution Assertions",
  "type": "object",
  "required": [
    "schemaVersion",
    "description",
    "source",
    "assertions",
    "explicitlyDocumentedLanes"
  ],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "description": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "schema": {
      "type": "string"
    },
    "contractDigest": {
      "type": "string"
    },
    "upstream": {
      "type": "object"
    },
    "explicitlyDocumentedLanes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "principle",
          "summary",
          "forbiddenTerms",
          "affectedSurfaces",
          "canonicalDocs",
          "protectorScripts",
          "evidenceMode",
          "repoScope",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "principle": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "forbiddenTerms": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object"
                }
              ]
            }
          },
          "affectedSurfaces": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "audit",
                "bridge",
                "cli",
                "data",
                "docs",
                "host",
                "mcp",
                "mesh",
                "permissions",
                "relay",
                "runtime",
                "sdk",
                "security",
                "storage",
                "ui"
              ]
            }
          },
          "canonicalDocs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "protectorScripts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "evidenceMode": {
            "enum": [
              "shape",
              "delegated",
              "fixture",
              "external-pending",
              "manual-review"
            ]
          },
          "repoScope": {
            "enum": [
              "clawjs",
              "clawix",
              "shared"
            ]
          },
          "status": {
            "enum": [
              "enforced",
              "partial",
              "external-pending",
              "manual"
            ]
          }
        }
      }
    }
  }
}
