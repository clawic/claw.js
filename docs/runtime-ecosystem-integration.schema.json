{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clawjs.dev/schemas/runtime-ecosystem-integration.schema.json",
  "title": "Runtime Ecosystem Integration Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "sourceSnapshotDate",
    "requiredDomains",
    "claimLadder",
    "defaults",
    "runtimes",
    "baselineAdapters"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sourceSnapshotDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "requiredDomains": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 10,
      "uniqueItems": true
    },
    "claimLadder": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 8,
      "uniqueItems": true
    },
    "defaults": {
      "type": "object"
    },
    "runtimes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "supportStage",
          "recommended",
          "production",
          "officialSnapshot",
          "tripleMatrix"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "supportStage": {
            "enum": [
              "dev_only",
              "inventoried",
              "projected",
              "operable",
              "write_back",
              "preserved",
              "native_parity",
              "recommended",
              "production"
            ]
          },
          "recommended": {
            "type": "boolean"
          },
          "production": {
            "type": "boolean"
          },
          "officialSnapshot": {
            "type": "object"
          },
          "tripleMatrix": {
            "type": "object",
            "required": [
              "nativeSurface",
              "clawDomainSurface",
              "linkMatrix"
            ]
          }
        }
      }
    },
    "baselineAdapters": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
