{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clawjs.dev/schemas/supply-chain-security-manifest.schema.json",
  "type": "object",
  "required": ["schemaVersion", "policy", "surfaces"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "policy": {
      "type": "object",
      "required": ["mode", "releaseHardFail", "sbomFormat", "provenanceTarget", "vulnerabilitySla"],
      "additionalProperties": false,
      "properties": {
        "mode": { "const": "baseline-plus-release-hard-fail" },
        "releaseHardFail": { "const": true },
        "sbomFormat": { "const": "CycloneDX JSON" },
        "provenanceTarget": { "const": "SLSA Build L2 for CI-built official artifacts" },
        "vulnerabilitySla": {
          "type": "object",
          "required": ["acknowledgeHours", "criticalPlanHours", "criticalFixHours", "highDays", "mediumDays", "lowDays"],
          "additionalProperties": false,
          "properties": {
            "acknowledgeHours": { "const": 48 },
            "criticalPlanHours": { "const": 24 },
            "criticalFixHours": { "const": 72 },
            "highDays": { "const": 7 },
            "mediumDays": { "const": 30 },
            "lowDays": { "const": 90 }
          }
        }
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/surface" }
    }
  },
  "$defs": {
    "status": { "enum": ["pass", "baseline_exception", "external_pending"] },
    "surface": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "path",
        "releaseCritical",
        "dependencyScope",
        "lockfile",
        "sbom",
        "provenance",
        "dependencyReview",
        "vulnerabilityTriage",
        "artifactIntegrity",
        "malwareReview"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
        "kind": {
          "enum": [
            "npm-workspace",
            "npm-app",
            "npm-template",
            "swiftpm-package",
            "cargo-app",
            "dotnet-project",
            "native-app",
            "plugin-package",
            "marketplace-package",
            "release-channel"
          ]
        },
        "path": { "type": "string", "minLength": 1 },
        "releaseCritical": { "type": "boolean" },
        "dependencyScope": { "enum": ["runtime", "devtool", "template", "native", "release"] },
        "lockfile": { "$ref": "#/$defs/control" },
        "sbom": { "$ref": "#/$defs/control" },
        "provenance": { "$ref": "#/$defs/control" },
        "dependencyReview": { "$ref": "#/$defs/control" },
        "vulnerabilityTriage": { "$ref": "#/$defs/control" },
        "artifactIntegrity": { "$ref": "#/$defs/control" },
        "malwareReview": { "$ref": "#/$defs/control" }
      }
    },
    "control": {
      "type": "object",
      "required": ["status", "evidence"],
      "additionalProperties": false,
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "evidence": { "type": "string", "minLength": 1 },
        "exception": { "type": "string", "minLength": 1 }
      }
    }
  }
}
