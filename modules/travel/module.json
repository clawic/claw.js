{
  "schemaVersion": 1,
  "kind": "conceptual_module_manifest",
  "id": "travel",
  "label": "Travel",
  "category": "world-places",
  "categoryLabel": "World & Places",
  "status": "dev_only",
  "sensitive": false,
  "description": "Countries and cities visited with notes",
  "signalVertical": "travel",
  "catalog": {
    "package": "@clawjs/signals",
    "path": "catalogs/travel.json",
    "catalogSize": 12,
    "hasSessions": true,
    "healthkitMapping": false,
    "iconHint": "plane"
  },
  "storage": {
    "owner": "claw",
    "tables": [
      "signals_verticals",
      "signals_variables",
      "signals_sessions",
      "signals_observations"
    ]
  },
  "publicCli": [
    "claw signals catalog",
    "claw signals observe",
    "claw signals list"
  ],
  "boundaries": {
    "packageApi": false,
    "serviceRuntime": false,
    "standaloneCli": false
  },
  "sourceOfTruth": [
    "tracking-registry.json",
    "packages/clawjs-core/src/domain-surface-registry.ts"
  ]
}
