{
  "schemaVersion": 1,
  "kind": "conceptual_module_manifest",
  "id": "games",
  "label": "Games",
  "category": "consumption-leisure",
  "categoryLabel": "Consumption & Leisure",
  "status": "dev_only",
  "sensitive": false,
  "description": "Games played with duration and companions",
  "signalVertical": "games",
  "catalog": {
    "package": "@clawjs/signals",
    "path": "catalogs/games.json",
    "catalogSize": 30,
    "hasSessions": true,
    "healthkitMapping": false,
    "iconHint": "gamepad"
  },
  "storage": {
    "owner": "claw",
    "tables": [
      "signals_verticals",
      "signals_variables",
      "signals_sessions",
      "signals_observations"
    ]
  },
  "publicCli": [
    "claw signals catalog",
    "claw signals observe",
    "claw signals list"
  ],
  "boundaries": {
    "packageApi": false,
    "serviceRuntime": false,
    "standaloneCli": false
  },
  "sourceOfTruth": [
    "tracking-registry.json",
    "packages/clawjs-core/src/domain-surface-registry.ts"
  ]
}
