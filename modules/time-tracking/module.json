{
  "schemaVersion": 1,
  "kind": "conceptual_module_manifest",
  "id": "time-tracking",
  "label": "Time tracking",
  "category": "time-productivity",
  "categoryLabel": "Time & Productivity",
  "status": "alpha",
  "sensitive": false,
  "description": "Manual pomodoros and focus sessions",
  "signalVertical": "time-tracking",
  "catalog": {
    "package": "@clawjs/signals",
    "path": "catalogs/time-tracking.json",
    "catalogSize": 12,
    "hasSessions": true,
    "healthkitMapping": false,
    "iconHint": "timer"
  },
  "storage": {
    "owner": "claw",
    "tables": [
      "signals_verticals",
      "signals_variables",
      "signals_sessions",
      "signals_observations"
    ]
  },
  "publicCli": [
    "claw signals catalog",
    "claw signals observe",
    "claw signals list"
  ],
  "boundaries": {
    "packageApi": false,
    "serviceRuntime": false,
    "standaloneCli": false
  },
  "sourceOfTruth": [
    "tracking-registry.json",
    "packages/clawjs-core/src/domain-surface-registry.ts"
  ]
}
