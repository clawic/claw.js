{
  "name": "clawjs-delegation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/bin/server.ts",
    "build": "tsup src/bin/server.ts src/bin/cli.ts --format esm --target node20 --out-dir dist --clean",
    "start": "node dist/server.js",
    "cli": "tsx src/bin/cli.ts",
    "test": "tsx --test src/**/*.test.ts tests/e2e/*.e2e.test.ts",
    "test:e2e": "tsx --test tests/e2e/*.e2e.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.6.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.15",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
