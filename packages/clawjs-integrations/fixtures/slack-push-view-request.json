{
  "method": "POST",
  "url": "https://slack.com/api/views.push",
  "headers": {
    "accept": "application/json",
    "authorization": "Bearer offline-slackBotToken-secret",
    "content-type": "application/json"
  },
  "body": {
    "trigger_id": "sample",
    "view": {
      "type": "modal",
      "title": {
        "type": "plain_text",
        "text": "Sample"
      },
      "blocks": [],
      "close": {
        "type": "plain_text",
        "text": "Close"
      }
    }
  }
}
