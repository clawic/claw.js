{
  "method": "POST",
  "url": "https://gitlab.com/api/v4/projects/sample/repository/branches",
  "headers": {
    "accept": "application/json",
    "content-type": "application/json",
    "private-token": "offline-gitlabToken-secret"
  },
  "body": {
    "branch": "sample",
    "ref": "main"
  }
}
