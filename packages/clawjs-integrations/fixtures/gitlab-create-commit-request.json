{
  "method": "POST",
  "url": "https://gitlab.com/api/v4/projects/sample/repository/commits",
  "headers": {
    "accept": "application/json",
    "content-type": "application/json",
    "private-token": "offline-gitlabToken-secret"
  },
  "body": {
    "branch": "main",
    "commit_message": "sample",
    "actions": [
      {
        "action": "create",
        "file_path": "sample.txt",
        "content": "sample"
      }
    ]
  }
}
