{
  "method": "POST",
  "url": "https://graph.facebook.com/v21.0/sample/messages",
  "headers": {
    "accept": "application/json",
    "authorization": "Bearer offline-whatsAppAccessToken-secret",
    "content-type": "application/json"
  },
  "body": {
    "messaging_product": "whatsapp",
    "recipient_type": "individual",
    "to": "sample",
    "type": "contacts",
    "contacts": [
      {
        "name": {
          "formatted_name": "Sample Contact"
        },
        "phones": [
          {
            "phone": "15551234567",
            "type": "WORK"
          }
        ]
      }
    ],
    "context": {
      "message_id": "sample"
    }
  }
}
