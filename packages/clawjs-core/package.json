{
  "name": "@clawjs/core",
  "version": "0.1.2",
  "description": "Core contracts and schemas for Claw.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Iván González Dávila",
    "url": "https://github.com/ivangdavila"
  },
  "homepage": "https://github.com/clawic/clawjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clawic/clawjs.git"
  },
  "bugs": {
    "url": "https://github.com/clawic/clawjs/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./catalogs": {
      "types": "./dist/catalogs.d.ts",
      "import": "./dist/catalogs.js"
    },
    "./compact-catalogs": {
      "types": "./dist/compact-catalogs.d.ts",
      "import": "./dist/compact-catalogs.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/catalogs.ts src/compact-catalogs.ts --format esm --out-dir dist --clean --target node20 --tsconfig tsconfig.build.json && tsc -p tsconfig.build.json --declaration --emitDeclarationOnly --rootDir src --outDir dist --noEmit false",
    "prepublishOnly": "node --import tsx ../../scripts/verify-regulated-domain-safety-goal.mjs && node ../../scripts/version-governance-check.mjs --release-gate && node ../../scripts/supply-chain-security-check.mjs --release"
  },
  "dependencies": {
    "zod": "^3.24.1"
  }
}
