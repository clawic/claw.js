{
  "name": "@clawjs/marketplace-agent-policy",
  "version": "0.1.0",
  "description": "Agent policy framework for the Clawix marketplace/* protocol: declarative auto-publish, auto-respond, auto-accept-interest and auto-lower-price decisions evaluated per Block with auditable side-effects.",
  "type": "module",
  "license": "MIT",
  "author": { "name": "Iván González Dávila", "url": "https://github.com/ivangdavila" },
  "homepage": "https://github.com/clawic/clawjs",
  "repository": { "type": "git", "url": "git+https://github.com/clawic/clawjs.git" },
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=20" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./types": { "types": "./dist/types.d.ts", "import": "./dist/types.js" },
    "./evaluator": { "types": "./dist/evaluator.d.ts", "import": "./dist/evaluator.js" },
    "./audit": { "types": "./dist/audit.d.ts", "import": "./dist/audit.js" }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup src/index.ts src/types.ts src/evaluator.ts src/audit.ts --format esm --dts --out-dir dist --clean --target node20",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@clawjs/marketplace": "*",
    "@clawjs/profile": "*"
  }
}
