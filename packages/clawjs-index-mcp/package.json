{
  "name": "@clawjs/index-mcp",
  "version": "0.1.2",
  "description": "MCP stdio server that exposes the @clawjs/index API as typed tools.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Iván González Dávila",
    "url": "https://github.com/ivangdavila"
  },
  "homepage": "https://github.com/clawic/clawjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clawic/clawjs.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "clawjs-index-mcp": "./bin/clawjs-index-mcp.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --out-dir dist --clean --target node20"
  },
  "dependencies": {
    "@clawjs/index": "0.1.2"
  }
}
