{
  "name": "@clawjs/search-mcp",
  "version": "0.1.2",
  "description": "MCP stdio server that exposes the @clawjs/search API as typed tools.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Iván González Dávila",
    "url": "https://github.com/ivangdavila"
  },
  "homepage": "https://github.com/clawic/clawjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clawic/clawjs.git"
  },
  "bugs": {
    "url": "https://github.com/clawic/clawjs/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "claw-search-mcp": "bin/claw-search-mcp.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --out-dir dist --clean --target node20",
    "prepublishOnly": "node --import tsx ../../scripts/verify-regulated-domain-safety-goal.mjs && node ../../scripts/version-governance-check.mjs --release-gate"
  },
  "dependencies": {
    "@clawjs/core": "0.1.2",
    "@clawjs/search": "0.1.2"
  }
}
