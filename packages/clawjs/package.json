{
  "name": "@clawjs/cli",
  "version": "0.1.2",
  "description": "Official CLI for Claw.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Iván González Dávila",
    "url": "https://github.com/ivangdavila"
  },
  "homepage": "https://github.com/clawic/clawjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clawic/clawjs.git"
  },
  "bugs": {
    "url": "https://github.com/clawic/clawjs/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "claw": "bin/claw.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --out-dir dist --clean --target node20 --external better-sqlite3 --external playwright --external @clawjs/agents --external @clawjs/audio --external @clawjs/integrations --external @clawjs/sessions",
    "prepublishOnly": "node --import tsx ../../scripts/verify-regulated-domain-safety-goal.mjs && node ../../scripts/version-governance-check.mjs --release-gate"
  },
  "dependencies": {
    "@clawjs/core": "0.1.2",
    "@clawjs/claw": "0.1.2",
    "@clawjs/database": "0.1.2",
    "@clawjs/search": "0.1.2",
    "@clawjs/workspace": "0.1.2",
    "better-sqlite3": "^12.9.0"
  }
}
