{
  "name": "@clawjs/marketplace",
  "version": "0.1.0",
  "description": "Reference implementation of the marketplace/1.0.0 peer-to-peer marketplace protocol: typed Intent envelopes, multi-key identity, encrypted mailbox, match receipts and broker/DHT discovery.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Iván González Dávila",
    "url": "https://github.com/ivangdavila"
  },
  "homepage": "https://github.com/clawic/clawjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clawic/clawjs.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cbor": {
      "types": "./dist/cbor.d.ts",
      "import": "./dist/cbor.js"
    },
    "./identity": {
      "types": "./dist/identity.d.ts",
      "import": "./dist/identity.js"
    },
    "./recovery": {
      "types": "./dist/recovery.d.ts",
      "import": "./dist/recovery.js"
    },
    "./handles": {
      "types": "./dist/handles.d.ts",
      "import": "./dist/handles.js"
    },
    "./wire": {
      "types": "./dist/wire.d.ts",
      "import": "./dist/wire.js"
    },
    "./mailbox": {
      "types": "./dist/mailbox.d.ts",
      "import": "./dist/mailbox.js"
    },
    "./match": {
      "types": "./dist/match.d.ts",
      "import": "./dist/match.js"
    },
    "./discovery": {
      "types": "./dist/discovery/index.d.ts",
      "import": "./dist/discovery/index.js"
    },
    "./verticals": {
      "types": "./dist/verticals/index.d.ts",
      "import": "./dist/verticals/index.js"
    },
    "./verticals/core": {
      "types": "./dist/verticals/core/index.d.ts",
      "import": "./dist/verticals/core/index.js"
    },
    "./verticals/plugin": {
      "types": "./dist/verticals/plugin.d.ts",
      "import": "./dist/verticals/plugin.js"
    },
    "./ratchet": {
      "types": "./dist/ratchet/index.d.ts",
      "import": "./dist/ratchet/index.js"
    },
    "./sync": {
      "types": "./dist/sync/index.d.ts",
      "import": "./dist/sync/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cbor.ts src/identity.ts src/recovery.ts src/handles.ts src/wire.ts src/mailbox.ts src/match.ts src/discovery/index.ts src/verticals/index.ts src/verticals/plugin.ts src/verticals/core/index.ts src/ratchet/index.ts src/sync/index.ts --format esm --dts --out-dir dist --clean --target node20",
    "test": "node --test --import tsx tests/*.test.ts"
  },
  "dependencies": {
    "@noble/curves": "^1.9.0",
    "@noble/hashes": "^1.8.0",
    "@noble/ciphers": "^1.3.0",
    "bonjour-service": "^1.3.0"
  }
}
