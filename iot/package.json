{
  "name": "clawjs-iot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/bin/server.ts",
    "dev:ui": "npm --prefix ui run dev",
    "build:ui": "npm --prefix ui run build",
    "build:server": "tsup src/bin/server.ts src/bin/cli.ts --format esm --target node20 --out-dir dist --clean",
    "build": "npm run build:ui && npm run build:server",
    "start": "node dist/server.js",
    "cli": "node dist/cli.js",
    "test": "tsx --test tests/e2e/backend.e2e.test.ts tests/e2e/cli.e2e.test.ts",
    "test:e2e": "playwright test -c playwright.config.ts"
  },
  "dependencies": {
    "@clawjs/core": "0.1.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^8.1.0",
    "better-sqlite3": "^12.4.1",
    "bonjour-service": "^1.3.0",
    "fastify": "^5.6.1"
  },
  "optionalDependencies": {
    "@project-chip/matter.js": "^0.9.0",
    "hap-nodejs": "^1.1.0",
    "mqtt": "^5.10.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.19.15",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
