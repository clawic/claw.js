{
  "name": "clawjs-secrets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/bin/server.ts",
    "build:ui": "npm --prefix ui run build",
    "build:server": "tsup src/bin/server.ts --format esm --target node20 --out-dir dist --clean",
    "build": "npm run build:server",
    "start": "node dist/server.js",
    "test": "/opt/homebrew/bin/node node_modules/.bin/tsx scripts/smoke-crypto.mjs && /opt/homebrew/bin/node node_modules/.bin/tsx scripts/smoke-audit.mjs && /opt/homebrew/bin/node node_modules/.bin/tsx scripts/smoke-secrets.mjs && /opt/homebrew/bin/node node_modules/.bin/tsx scripts/smoke-plugins.mjs",
    "test:naming": "/opt/homebrew/bin/node scripts/naming-gate.mjs"
  },
  "dependencies": {
    "@clawjs/core": "0.1.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^8.1.0",
    "@noble/ciphers": "^1.3.0",
    "@noble/hashes": "^1.7.0",
    "better-sqlite3": "^12.4.1",
    "bip39": "^3.1.0",
    "fastify": "^5.6.1",
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.19.15",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
