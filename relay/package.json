{
  "name": "@clawjs/relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/bin/server.ts",
    "dev:ui": "npm --prefix ui run dev",
    "build:ui": "npm --prefix ui run build",
    "build:server": "tsup src/bin/server.ts src/bin/connector.ts src/bin/service-proxy.ts src/bin/cli.ts --format esm --target node20 --out-dir dist --clean",
    "build": "npm run build:ui && npm run build:server",
    "start": "node dist/server.js",
    "connector": "node dist/connector.js",
    "service-proxy": "node dist/service-proxy.js",
    "cli": "node dist/cli.js",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "tsx --test tests/e2e/**/*.test.ts",
    "test:e2e:ui": "npm run build && npx playwright test -c playwright.ui.config.ts"
  },
  "dependencies": {
    "@clawjs/core": "0.1.2",
    "@clawjs/claw": "file:../packages/clawjs-node",
    "@clawjs/workspace": "file:../packages/clawjs-workspace",
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^8.1.0",
    "@fastify/websocket": "^11.2.0",
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.4.1",
    "bonjour-service": "^1.3.0",
    "fastify": "^5.6.1",
    "jose": "^6.1.0",
    "playwright": "^1.56.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.19.15",
    "@types/ws": "^8.18.1",
    "@types/nodemailer": "^6.4.17",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "nodemailer": "^6.9.16"
  }
}
