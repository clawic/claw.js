{
  "name": "clawjs-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "dev:ui": "npm --prefix ui run dev",
    "build:ui": "npm --prefix ui run build",
    "build:server": "tsup src/server/main.ts --format esm --target node20 --out-dir dist --clean",
    "build": "npm run build:ui && npm run build:server",
    "start": "node dist/main.js",
    "test:e2e:ui": "npm run build && npx playwright test -c playwright.config.ts"
  },
  "dependencies": {
    "@clawjs/core": "0.1.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^8.1.0",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.6.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.15",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
