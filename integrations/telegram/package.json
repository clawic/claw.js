{
  "name": "clawjs-telegram",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/bin/server.ts",
    "dev:ui": "npm --prefix ui run dev",
    "build:ui": "npm --prefix ui run build",
    "build:server": "tsup src/bin/server.ts src/server/app.ts --format esm --target node20 --out-dir dist --clean",
    "build": "npm run build:ui && npm run build:server",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@clawjs/core": "0.1.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^8.1.0",
    "fastify": "^5.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
